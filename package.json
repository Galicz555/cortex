{
  "name": "cortex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "daily": "node src/main.ts run",
    "context": "node src/main.ts context",
    "seed": "node src/main.ts seed",
    "projections": "node src/main.ts projections",
    "advisories": "node src/main.ts advisories",
    "practices": "node src/main.ts practices",
    "compare": "node src/main.ts compare",
    "test": "vitest run",
    "types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm types && pnpm test"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
